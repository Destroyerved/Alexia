# Alexia Production Environment Configuration
# Copy to .env and configure at least one LLM provider (or run local Ollama). Never commit .env!

# ---------------------------------------------------------------------------
# 1. LLM Provider Selection (auto | openai | gemini | anthropic | openrouter | nebius | ollama | custom)
# ---------------------------------------------------------------------------
ALEXIA_LLM_PROVIDER=auto

# Configure ANY ONE (or more) of the providers below:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NEBIUS_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional explicit overrides for custom OpenAI-compatible endpoints or model IDs:
ALEXIA_LLM_BASE_URL=
ALEXIA_LLM_API_KEY=
ALEXIA_MODEL_NANO=
ALEXIA_MODEL_SUPER=
ALEXIA_MODEL_ULTRA=

# ---------------------------------------------------------------------------
# 2. Grounding & GitHub Integration (Optional)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 3. Platform Security & Operator Bootstrap
# ---------------------------------------------------------------------------
ALEXIA_ENV=production
ALEXIA_SECRET_KEY=
ALEXIA_ADMIN_USERNAME=admin
ALEXIA_ADMIN_PASSWORD=
ALEXIA_DATA_DIR=data

# ---------------------------------------------------------------------------
# 4. Daily Budget Guardrails
# ---------------------------------------------------------------------------
DAILY_TOKEN_BUDGET=5000000
DAILY_USD_BUDGET=10.00

# ---------------------------------------------------------------------------
# 5. Reverse-Proxy WAF Gateway & Optional Edge Hooks
# ---------------------------------------------------------------------------
ALEXIA_GATEWAY_PORT=8000
ALEXIA_ENABLE_SHOPLITE_TARGET=1
CADDY_ADMIN_URL=
ALEXIA_ENABLE_OS_FIREWALL=false

# ---------------------------------------------------------------------------
# 6. Web Push (VAPID) & Alerts (Optional)
# ---------------------------------------------------------------------------
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@localhost
ALEXIA_ALERT_NTFY=
