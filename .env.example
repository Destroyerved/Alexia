# Alexia Environment Configuration Example
# Copy this file to .env and configure with your actual keys. Never commit .env!

# Nebius Token Factory (Inference API)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily Search API (Grounding & CVE Lookup)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# GitHub Integration (Fine-grained Personal Access Token)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=Sam-bot-dev/Alexia
GITHUB_WEBHOOK_SECRET=alexia_webhook_secret_demo_123

# Mobile Companion & Push Notifications (VAPID)
VAPID_PRIVATE_KEY=your_vapid_private_key_pem
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_CLAIMS_EMAIL=admin@alexia-guardian.dev

# Alexia Platform Security & State
# Set ALEXIA_ENV=production in any shared or internet-facing deployment. Production
# disables simulated health probes and requires signed GitHub webhooks.
ALEXIA_ENV=development
ALEXIA_SECRET_KEY=change_me_super_secret_master_key_for_hmac_and_tokens
# Every store lives under this directory. The server and CLI resolve the same path,
# so do not set ALEXIA_DB and ALEXIA_DATA_DIR to different locations.
ALEXIA_DATA_DIR=data
# Optional explicit database override (defaults to $ALEXIA_DATA_DIR/alexia.db).
# ALEXIA_DB=data/alexia.db
EVIDENCE_DIR=data/evidence
SNAPSHOT_DIR=data/snapshots

# Telemetry collectors started by the API process
ALEXIA_COLLECTORS=auto
ALEXIA_DOCKER_EVENTS=auto
ALEXIA_HEALTH_INTERVAL_SECONDS=10
ALEXIA_HEALTH_FAILURE_THRESHOLD=3
# ALEXIA_LOG_PATH=data/logs/app.log
# ALEXIA_TARGET_CONTAINER=shoplite-api

# Security toggles for local demos. Leave both at 0 outside development.
ALEXIA_ALLOW_SIMULATED_HEALTH=1
ALEXIA_ALLOW_UNSIGNED_WEBHOOKS=1

# Daily Budget & Fallback Guard
DAILY_TOKEN_BUDGET=5000000
DAILY_USD_BUDGET=10.00
REPLAY_MODE_ON_EXHAUST=true

# Public demo guard: one scenario at a time + this cooldown for remote visitors (0 = off; 120 recommended
# for a shared demo URL). The operator on the server itself is never rate-limited.
ALEXIA_SCENARIO_COOLDOWN_SECONDS=0

# Target App (ShopLite) Configuration
SHOPLITE_PORT=8000
SHOPLITE_URL=http://localhost:8000
DEMO_VULN=1
DATABASE_URL=sqlite:///./data/shoplite.db
