# Alexia Environment Configuration Example
# Copy this file to .env and configure with your actual keys. Never commit .env!

# Nebius Token Factory (Inference API)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily Search API (Grounding & CVE Lookup)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# GitHub Integration (Fine-grained Personal Access Token)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=Sam-bot-dev/Alexia
GITHUB_WEBHOOK_SECRET=alexia_webhook_secret_demo_123

# Mobile Companion & Push Notifications (VAPID)
VAPID_PRIVATE_KEY=your_vapid_private_key_pem
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_CLAIMS_EMAIL=admin@alexia-guardian.dev

# Alexia Platform Security & State
ALEXIA_ENV=development
ALEXIA_SECRET_KEY=change_me_super_secret_master_key_for_hmac_and_tokens
ALEXIA_DB_PATH=data/alexia.db
EVIDENCE_DIR=data/evidence
SNAPSHOT_DIR=data/snapshots

# Daily Budget & Fallback Guard
DAILY_TOKEN_BUDGET=5000000
DAILY_USD_BUDGET=10.00
REPLAY_MODE_ON_EXHAUST=true

# Target App (ShopLite) Configuration
SHOPLITE_PORT=8000
SHOPLITE_URL=http://localhost:8000
DEMO_VULN=1
DATABASE_URL=sqlite:///./data/shoplite.db
