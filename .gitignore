# Rust & Build Artifacts
/target/
*.pdb
*.exe
*.dll
*.so
*.dylib

# Frontend Dependencies & Ephemeral Build Cache
# Note: `dashboard/static/` IS tracked so `cargo build --release` embeds the React 19 UI out-of-the-box without requiring Node.js.
/ui/node_modules/
/ui/dist/
/ui/.vite/

# Runtime State, Databases, Logs, Snapshots & Release Archives
/data/
*.redb
*.redb-lock
*.db
*.sqlite
*.sqlite3
*.log
*.log.gz
*.bak
*.tar.gz

# Secrets & Local Environment Overrides (NEVER COMMIT)
.env
.env.*
!.env.example
target-service/.env
target-service/.env.*

# Python / Target Sandbox Scratch Artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# OS & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
