#!/usr/bin/env bash
# MainFrame DevSecOps CLI Launcher
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    PY_BIN="$SCRIPT_DIR/.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PY_BIN="python3"
else
    PY_BIN="python"
fi

PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "$PY_BIN" "$SCRIPT_DIR/MainFrame.py" "$@"
